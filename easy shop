// --- 2. WIDGET LOGIC ---
window.addEventListener('load', function() {
    
    // --- SETTINGS ---
    const BOX_SIZE = 6; 
    const SHOP_URL = '/shop-all'; 
    const CART_URL = '/cart'; 
    const BULK_LIMIT = 97; 
    const BULK_EMAIL = 'prairiemacaronsorders@gmail.com';
    const COOKIE_IMG_URL = 'https://images.squarespace-cdn.com/content/v1/69865a36c6337862010d7605/1770412600346-LMCMPQMW489CISGETV0R/Lemon_Angle+2.png?format=1000w';
    
    // PRICING LOGIC
    // Tier 1: 6-11 Cookies = Flat $2.00 Savings
    // Tier 2: 12+ Cookies = $0.75 off PER cookie
    const DISCOUNT_PER_ITEM_BULK = 0.75; 
    const DISCOUNT_FLAT_HALF_DOZEN = 2.00;
    const MIN_QTY_FOR_BULK = 12;
    // ----------------
    
    // 1. CREATE WIDGET UI
    const widget = document.createElement('div');
    widget.id = 'cookie-promo-bar';
    widget.innerHTML = `
        <div class="bar-content">
            <div class="bar-left">
                <img src="${COOKIE_IMG_URL}" class="cookie-icon" alt="Cookie">
                <div class="bar-text">
                    <div id="promo-main">Start Your Box <div class="min-msg">Minimum Order: 6</div></div>
                    <div id="promo-sub">Buy 6 Save $2! Buy 12 Save $9!</div>
                </div>
            </div>
            <div class="bar-right">
                <div id="promo-count">0</div>
            </div>
        </div>
        <div id="progress-indicator"></div>
    `;
    document.body.appendChild(widget);

    // --- ANIMATION TRIGGER ---
    setTimeout(() => {
        widget.classList.add('widget-visible');
        setTimeout(() => {
            widget.classList.add('widget-interactive');
        }, 1000);
    }, 500);

    const countBadge = document.getElementById('promo-count');
    
    // 2. HELPER: Native Cart Reader
    function getNativeHeaderCount() {
        const selectors = ['.sqs-cart-quantity', '.icon-cart-quantity', '.cart-quantity'];
        for (let sel of selectors) {
            const el = document.querySelector(sel);
            if (el) {
                const num = parseInt(el.textContent.trim());
                if (!isNaN(num) && num > 0) return num;
            }
        }
        return 0;
    }

    // 3. HELPER: Calculate Savings
    function calcSavings(q) {
        if (q < 6) return 0; // Less than 6: No discount
        if (q < 12) return DISCOUNT_FLAT_HALF_DOZEN; // 6-11: Save $2.00 total
        return q * DISCOUNT_PER_ITEM_BULK; // 12+: Save $0.75 per item
    }

    function formatMoney(amount) {
        return amount.toLocaleString('en-US', {style:'currency', currency:'USD'});
    }

    // 4. HELPER: Brand Color Confetti
    function fireConfetti() {
        const isMobile = window.innerWidth < 600;
        const originX = isMobile ? 0.5 : 0.9;
        const originY = 0.9; 

        const colors = [
            '#D4AF37', // Brand Gold
            '#004F59', // Brand Deep Teal
            '#C9B091', // Brand Beige
            '#FFFFFF', // White
            '#F0EAD6'  // Cream
        ];

        confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: originY, x: originX },
            colors: colors, 
            zIndex: 100000,
            disableForReducedMotion: true
        });
    }

    // 5. HELPER: Inject Message ABOVE Checkout Button
    function injectCheckoutWarning() {
        const btns = document.querySelectorAll('.cart-checkout-button, [data-test="checkout-button"]');
        btns.forEach(btn => {
            const parent = btn.parentNode;
            if (!parent.querySelector('.qty-warning-msg')) {
                const msg = document.createElement('div');
                msg.className = 'qty-warning-msg';
                msg.innerText = "Please order in increments of 6\nHalf Dozen or Dozen Boxes only";
                parent.insertBefore(msg, btn);
            }
        });
    }

    // 6. HELPER: Inject Navigation Buttons
    function injectNavButtons() {
        if (document.getElementById('custom-nav-wrapper')) return;
        const titleElement = document.querySelector('h1.ProductItem-details-title, h1.product-title, .ProductItem-summary h1, .product-item h1');

        if (titleElement) {
            const wrapper = document.createElement('div');
            wrapper.id = 'custom-nav-wrapper';
            
            const backBtn = document.createElement('a');
            backBtn.className = 'nav-btn back-btn';
            backBtn.href = SHOP_URL;
            backBtn.innerHTML = '← Back to Shop';

            const cartBtn = document.createElement('a');
            cartBtn.className = 'nav-btn cart-btn';
            cartBtn.href = CART_URL;
            cartBtn.innerHTML = `
                CART 
                <svg class="nav-cart-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
            `;

            wrapper.appendChild(backBtn);
            wrapper.appendChild(cartBtn);
            titleElement.parentNode.insertBefore(wrapper, titleElement);
        }
    }

    // --- CART PAGE INJECTION LOGIC ---
    function updateCartPageDisplay(qty) {
        if (!document.querySelector('.cart-container') && !document.querySelector('.sqs-cart-container')) return;
        const subtotalEl = document.querySelector('.cart-subtotal-price, .sqs-cart-subtotal .price, [data-test="cart-subtotal"] .value');
        if (!subtotalEl) return;

        const discountAmount = calcSavings(qty);
        let discountRow = document.getElementById('custom-discount-row');
        let totalRow = document.getElementById('custom-total-row');
        
        if (discountAmount > 0) {
            let rawSub = subtotalEl.textContent.replace(/[^0-9.-]+/g,"");
            let subtotalVal = parseFloat(rawSub);
            if (isNaN(subtotalVal)) return;

            let finalTotal = subtotalVal - discountAmount;

            if (!discountRow) {
                discountRow = document.createElement('div');
                discountRow.id = 'custom-discount-row';
                discountRow.className = 'custom-cart-row';
                subtotalEl.parentNode.parentNode.appendChild(discountRow);
            }
            if (!totalRow) {
                totalRow = document.createElement('div');
                totalRow.id = 'custom-total-row';
                totalRow.className = 'custom-cart-row';
                subtotalEl.parentNode.parentNode.appendChild(totalRow);
            }

            // TEXT UPDATE HERE: "Quantity Discount Applied"
            discountRow.innerHTML = `<span>Quantity Discount Applied:</span> <span class="custom-discount-val">-${formatMoney(discountAmount)}</span>`;
            totalRow.innerHTML = `<span>Estimated Total:</span> <span class="custom-total-val">${formatMoney(finalTotal)}</span>`;
            document.body.classList.add('has-custom-discount');
        } else {
            if (discountRow) discountRow.remove();
            if (totalRow) totalRow.remove();
            document.body.classList.remove('has-custom-discount');
        }
    }

    // 7. THE LOGIC ENGINE
    let currentQty = 0; 
    let lastKnownFullBoxes = -1; 

    function updateWidget() {
        injectCheckoutWarning();
        injectNavButtons();

        fetch('/api/commerce/cart?t=' + Date.now()) 
        .then(response => response.json())
        .then(data => {
            let qty = 0;
            if (data && typeof data.totalQuantity !== 'undefined') {
                qty = parseInt(data.totalQuantity);
            }
            if (qty === 0 || isNaN(qty)) {
                const nativeQty = getNativeHeaderCount();
                if (nativeQty > 0) qty = nativeQty;
            }
            
            currentQty = qty;
            countBadge.textContent = qty;
            
            updateCartPageDisplay(qty);

            const currentFullBoxes = Math.floor(qty / BOX_SIZE);

            if (lastKnownFullBoxes !== -1) {
                const boxesGained = currentFullBoxes - lastKnownFullBoxes;
                if (boxesGained > 0) {
                    for (let i = 0; i < boxesGained; i++) {
                        setTimeout(fireConfetti, i * 300);
                    }
                }
            }
            lastKnownFullBoxes = currentFullBoxes;
            
            const remainder = qty % BOX_SIZE;
            const isPerfect = (remainder === 0 && qty > 0);
            const fullBoxes = Math.floor(qty / BOX_SIZE);

            let mainMsg = "";
            let subMsg = "";
            let theme = "neutral";
            let pct = 0;

            if (qty >= BULK_LIMIT) {
                theme = "bulk-order"; 
                mainMsg = "Contact us for your custom discount";
                subMsg = `<a href="mailto:${BULK_EMAIL}" class="email-link">${BULK_EMAIL}</a>`; 
                document.body.classList.add('cart-locked');
                pct = 100;
            } else if (qty === 0) {
                theme = "neutral";
                mainMsg = `Start Your Box <div class="min-msg">Minimum Order: 6</div>`;
                subMsg = "Buy 6 Save $2.00!"; 
                document.body.classList.remove('cart-locked');
            } else if (isPerfect) {
                document.body.classList.remove('cart-locked');
                const currentSave = calcSavings(qty);
                const nextTargetQty = qty + 6;
                const nextSave = calcSavings(nextTargetQty);

                if (qty === 96) {
                    theme = "gold";
                    mainMsg = "16 Boxes Perfect!";
                    subMsg = `💰 You saved ${formatMoney(currentSave)}!`;
                } else if (qty === 6) {
                    theme = "success"; 
                    mainMsg = "1 Box Full!";
                    subMsg = `You saved $2.00! Add 6 more to save $9.00!`;
                } else {
                    theme = "gold";
                    mainMsg = `${fullBoxes} Boxes Perfect!`;
                    subMsg = `💰 Saved ${formatMoney(currentSave)}. Add 6 to save ${formatMoney(nextSave)}!`;
                }
                pct = 100;
            } else {
                document.body.classList.add('cart-locked');
                theme = "locked";
                const needed = BOX_SIZE - remainder;
                const nextTargetQty = (fullBoxes + 1) * 6;
                const nextSave = calcSavings(nextTargetQty);
                
                if (qty < 6) {
                    mainMsg = `Box Incomplete <div class="min-msg">Minimum Order: 6</div>`;
                    subMsg = `Add ${needed} to finish Box #1`;
                } else {
                    mainMsg = `Finish Box #${fullBoxes + 1}`;
                    subMsg = `Add ${needed} to UNLOCK ${formatMoney(nextSave)} OFF!`;
                }
                pct = (remainder / 6) * 100;
            }

            widget.className = `theme-${theme} widget-visible widget-interactive`;
            const mainText = document.getElementById('promo-main');
            const subText = document.getElementById('promo-sub');
            const progressBar = document.getElementById('progress-indicator');
            if(mainText) mainText.innerHTML = mainMsg;
            if(subText) subText.innerHTML = subMsg; 
            if(progressBar) progressBar.style.width = pct + "%";

        })
        .catch(err => console.error(err));
    }

    updateWidget();
    setInterval(updateWidget, 800);

    widget.addEventListener('click', (e) => {
        if (e.target.closest('#custom-nav-wrapper')) return;
        if (e.target.tagName === 'A') return;
        e.preventDefault();
        if (currentQty >= BULK_LIMIT) {
            window.location.href = `mailto:${BULK_EMAIL}`;
            return;
        }
        window.location.assign(SHOP_URL);
    });
});
</script>

<style>
/* --- V56 STYLES --- */

/* 1. GLOBAL PADDING */
body { padding-bottom: 130px !important; }
@media (max-width: 600px) { body { padding-bottom: 110px !important; } }

/* 2. CUSTOM NAV BUTTONS */
#custom-nav-wrapper {
    display: flex; justify-content: space-between; align-items: center;
    width: 100%; margin-bottom: 25px; padding: 0 2px; box-sizing: border-box;
}
.nav-btn {
    font-family: 'Poppins', sans-serif; font-weight: 700; text-decoration: none !important;
    font-size: 13px; letter-spacing: 0.05em; text-transform: uppercase; cursor: pointer;
    color: #ffffff !important; text-shadow: 0 1px 2px rgba(0,0,0,0.3);
    opacity: 0.95; transition: all 0.2s ease; display: flex; align-items: center; gap: 8px;
}
.nav-btn:hover { color: #D4AF37 !important; opacity: 1; }
.back-btn:hover { transform: translateX(-3px); }
.cart-btn:hover { transform: translateY(-2px); }
.nav-cart-icon { display: block; width: 18px; height: 18px; }

/* 3. CHECKOUT WARNING */
.qty-warning-msg {
    display: none; text-align: center; font-size: 14px; color: #d93025; margin-bottom: 15px; 
    font-weight: 600; line-height: 1.5; font-family: 'Poppins', sans-serif; padding: 0 10px; white-space: pre-wrap;
}
body.cart-locked .qty-warning-msg { display: block; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* 4. WIDGET */
#cookie-promo-bar {
    position: fixed; bottom: 30px; right: 30px; width: auto; min-width: 340px; max-width: 420px;
    background: #fff; border-radius: 18px; box-shadow: 0 12px 40px rgba(0,0,0,0.15); z-index: 99999;
    font-family: 'Poppins', sans-serif; overflow: hidden; cursor: pointer; border: 1px solid rgba(0,0,0,0.06);
    transform: translateY(150%); opacity: 0; transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.8s ease;
}
#cookie-promo-bar.widget-visible { transform: translateY(0); opacity: 1; }
#cookie-promo-bar.widget-interactive:hover { transform: translateY(-4px); }
.cookie-icon { width: 45px; height: auto; display: block; object-fit: contain; }

@media (max-width: 600px) {
    #cookie-promo-bar { bottom: 20px; left: 15px; right: 15px; min-width: 0 !important; width: auto !important; max-width: 100%; padding-bottom: 0; }
    .theme-bulk-order .cookie-icon { display: none !important; }
    .theme-bulk-order #promo-count { display: none !important; } 
    .theme-bulk-order .bar-content { justify-content: center !important; text-align: center !important; }
    .theme-bulk-order .bar-left { justify-content: center !important; width: 100%; }
    .theme-bulk-order .bar-text { align-items: center !important; width: 100%; }
    .theme-bulk-order .email-link { font-size: 11px !important; white-space: nowrap !important; }
